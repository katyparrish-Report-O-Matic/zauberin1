{
  "name": "RateLimitLog",
  "type": "object",
  "properties": {
    "api_settings_id": {
      "type": "string",
      "description": "Reference to ApiSettings"
    },
    "organization_id": {
      "type": "string",
      "description": "Organization this log belongs to"
    },
    "endpoint": {
      "type": "string",
      "description": "API endpoint called"
    },
    "limit_total": {
      "type": "number",
      "description": "Total rate limit"
    },
    "limit_remaining": {
      "type": "number",
      "description": "Remaining requests"
    },
    "limit_reset": {
      "type": "string",
      "format": "date-time",
      "description": "When limit resets"
    },
    "response_time_ms": {
      "type": "number",
      "description": "Response time"
    },
    "priority_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "description": "Request priority"
    }
  },
  "required": [
    "api_settings_id",
    "organization_id",
    "endpoint"
  ]
}