{
  "name": "Conversion",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this conversion belongs to"
    },
    "name": {
      "type": "string",
      "description": "Conversion name"
    },
    "conversion_type": {
      "type": "string",
      "enum": [
        "transaction",
        "lead",
        "call",
        "form_submit",
        "download",
        "signup",
        "page_view",
        "custom"
      ],
      "description": "Type of conversion"
    },
    "value": {
      "type": "number",
      "description": "Default conversion value"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency for value"
    },
    "attribution_model": {
      "type": "string",
      "enum": [
        "last_click",
        "first_click",
        "linear",
        "time_decay",
        "position_based",
        "data_driven"
      ],
      "default": "last_click",
      "description": "Attribution model"
    },
    "attribution_window_days": {
      "type": "number",
      "default": 30,
      "description": "Days to look back for attribution"
    },
    "counting": {
      "type": "string",
      "enum": [
        "one_per_click",
        "every",
        "unique"
      ],
      "default": "one_per_click",
      "description": "How to count conversions"
    },
    "source_mappings": {
      "type": "object",
      "description": "Map to platform-specific conversion actions",
      "properties": {
        "google_ads_conversion_id": {
          "type": "string"
        },
        "google_ads_label": {
          "type": "string"
        },
        "ga4_event_name": {
          "type": "string"
        },
        "ga4_event_parameters": {
          "type": "object"
        },
        "call_tracking_outcome": {
          "type": "string"
        },
        "facebook_pixel_event": {
          "type": "string"
        }
      }
    },
    "category": {
      "type": "string",
      "description": "Conversion category for grouping"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether conversion tracking is active"
    },
    "include_in_conversions": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include in main conversion count"
    },
    "view_through_window_days": {
      "type": "number",
      "default": 1,
      "description": "View-through conversion window"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_count": {
            "type": "number"
          },
          "target_value": {
            "type": "number"
          },
          "time_period": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly"
            ]
          }
        }
      },
      "description": "Conversion goals"
    }
  },
  "required": [
    "organization_id",
    "name",
    "conversion_type"
  ]
}