{
  "name": "TrackingNumber",
  "type": "object",
  "properties": {
    "tracking_number": {
      "type": "string",
      "description": "The phone number"
    },
    "description": {
      "type": "string",
      "description": "Name/label for the tracking number"
    },
    "account_name": {
      "type": "string",
      "description": "CTM account name"
    },
    "account_id": {
      "type": "string",
      "description": "CTM account ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "description": "Active or inactive status"
    },
    "source": {
      "type": "string",
      "description": "Source system (e.g., ctm)"
    },
    "sync_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last synced"
    }
  },
  "required": [
    "tracking_number",
    "source"
  ]
}